# ---- PostgreSQL ----
POSTGRES_DB=whatsapp
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=change-me-to-a-strong-db-password

# ---- Django ----
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# For access by raw IP, "*" is simplest. Tighten to your IP/domain for production.
DJANGO_ALLOWED_HOSTS=*
# Only needed if you use the Django admin. e.g. http://203.0.113.10:8080
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- Portal ----
# Host port the web portal is served on. Use 80 for a port-less URL.
PORTAL_PORT=8080

# ---- Linked device identity ----
# What WhatsApp shows for this device under "Linked devices". Only applied when
# the QR code is scanned -- changing it does not rename an existing link.
# DEVICE_OS: operating system, e.g. Windows, Mac OS, Ubuntu
# DEVICE_PLATFORM: browser, e.g. CHROME, FIREFOX, SAFARI, EDGE
DEVICE_OS=Windows
DEVICE_PLATFORM=CHROME
